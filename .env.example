# Local development only. Replace all placeholders before use.
MONGODB_URI=mongodb://127.0.0.1:27017/smartexam
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=7d
COOKIE_NAME=oex_session
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=12
AES_MASTER_KEY=replace-with-a-random-32-byte-key
CRON_SECRET=

# Production requires COOKIE_SECURE=true, strong JWT_SECRET and CRON_SECRET,
# and an AES_MASTER_KEY that encodes exactly 32 bytes.
